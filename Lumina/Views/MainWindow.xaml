<Window x:Class="Lumina.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login"
        WindowStartupLocation="CenterScreen"
        Background="White"
        Height="600" Width="800">

    <Window.Resources>
        <!-- Estilo para botones redondeados -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="20"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Contenedor principal -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="153*"/>
            <ColumnDefinition Width="237*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" 
                    HorizontalAlignment="Left" 
                    Width="280" 
                    Margin="260,0,0,0" 
                    Grid.ColumnSpan="2" >

            <!-- Título principal -->
            <TextBlock Text="Lumina"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

            <!-- Subtítulo -->
            <TextBlock Text="Perfil"
                       FontSize="20"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Avatar con flechas -->
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <!-- Flecha izquierda -->
                <Button Content="⟨"
                        FontSize="20"
                        Width="40" Height="40"
                        Background="Transparent"
                        BorderThickness="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"/>

                <!-- Imagen avatar redonda -->
                <Border Grid.Column="1"
                        Width="180" Height="180"
                        Background="Transparent"
                        CornerRadius="90">

                    <Image Source="C:\Users\andre\Downloads\Lumina\Lumina\Lumina\Images\Dog_Lumina3.png"
                           Width="180" Height="180"
                           Stretch="Uniform">
                        <Image.Clip>
                            <EllipseGeometry Center="90,90" RadiusX="90" RadiusY="90"/>
                        </Image.Clip>
                    </Image>
                </Border>

                <!-- Flecha derecha -->
                <Button Content="⟩"
                        FontSize="20"
                        Width="40" Height="40"
                        Background="Transparent"
                        BorderThickness="0"
                        Grid.Column="2"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Botones inferiores -->
            <Button Content="AvatarName" Style="{StaticResource RoundedButton}"/>
            <Button Content="Nombre" Style="{StaticResource RoundedButton}"/>
            <Button Content="Guardar" Style="{StaticResource RoundedButton}" Margin="0,15,0,0" Background="#d9dcd6"/>
        </StackPanel>
    </Grid>
</Window>
