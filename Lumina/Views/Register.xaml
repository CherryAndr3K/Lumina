<Window x:Class="Lumina.Views.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro" Height="400" Width="350"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Crear cuenta"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBox x:Name="txtCorreo"
         Text="Correo"
         Tag="Correo"
         Foreground="Gray"
         GotFocus="Placeholder_GotFocus"
         LostFocus="Placeholder_LostFocus"
         Margin="0,10,0,0"
         Height="35"/>

            <TextBox x:Name="txtNombre"
         Text="Nombre"
         Tag="Nombre"
         Foreground="Gray"
         GotFocus="Placeholder_GotFocus"
         LostFocus="Placeholder_LostFocus"
         Margin="0,10,0,0"
         Height="35"/>

            <TextBox x:Name="txtPassword"
         Text="Contraseña"
         Tag="Contraseña"
         Foreground="Gray"
         GotFocus="Placeholder_GotFocus"
         LostFocus="Placeholder_LostFocus"
         Margin="0,10,0,0"
         Height="35"/>

            <Button Content="Registrar"
        Background="Black"
        Foreground="White"
        Margin="0,20,0,0"
        Height="40"
        Click="BtnRegistrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
