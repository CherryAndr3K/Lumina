<Window x:Class="Lumina.Views.Favoritos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMINA - Favoritos" Height="576" Width="829"
        Background="#EDEDE9"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">

    <!-- Grid principal: barra superior + contenido -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior personalizada -->
        <Grid Grid.Row="0" Background="#D6CCC2" MouseDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="LUMINA" VerticalAlignment="Center" Margin="10,0,0,0"
                       FontWeight="Bold" FontSize="16"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Width="15" Height="15" Margin="2" Click="Minimize_Click" Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/minimizar.png" Stretch="Uniform"/>
                </Button>
                <Button x:Name="MaximizeButton" Width="15" Height="15" Margin="2" Click="Maximize_Click" Background="Transparent" BorderThickness="0">
                    <Image x:Name="MaximizeIcon" Source="/Images/Iconos/maximizar.png" Stretch="Uniform"/>
                </Button>
                <Button Width="15" Height="15" Margin="2" Click="Close_Click" Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/cerrar.png" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Contenido principal con barra lateral y zona central -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Barra lateral izquierda -->
            <Grid Grid.Column="0" Background="#E3D5CA" Margin="0,0,4,0" Grid.ColumnSpan="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Width="40" Height="40" Margin="5" Click="Home_Click"
                            BorderBrush="Transparent" Background="Transparent">
                        <Image Source="/Images/Iconos/Home.png" Width="24" Height="24"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" Click="Libros_Click"
                            BorderBrush="Transparent" Background="Transparent">
                        <Image Source="/Images/Iconos/Libros.png" Width="24" Height="24"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" Click="Musica_Click"
                            BorderBrush="Transparent" Background="Transparent">
                        <Image Source="/Images/Iconos/Musica.png" Width="24" Height="24"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" Click="Peliculas_Click"
                            BorderBrush="Transparent" Background="Transparent">
                        <Image Source="/Images/Iconos/Pelicula.png" Width="24" Height="24"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" Click="Favoritos_Click"
                            BorderBrush="Transparent" Background="Transparent">
                        <Image Source="/Images/Iconos/Favoritos.png" Width="24" Height="24"/>
                    </Button>
                    <Button Width="40" Height="40" BorderBrush="Transparent" Background="Transparent" Click="Login_Click">
                        <Image Source="C:\Users\andre\Desktop\Lumina\Lumina\Lumina\Images\Iconos\usuario.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Zona central: encabezado + buscador + lista -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">

                    <!-- Encabezado + buscador -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Favoritos" FontFamily="Fonts/#Roboto" FontSize="25"
                                   VerticalAlignment="Center" Grid.Column="0" Margin="0,2,10,0"/>

                        <!-- barra de búsqueda -->
                        <Border CornerRadius="15" Background="#D6CCC2" Width="232" Grid.Column="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="/Images/Iconos/lupa.png" Width="16" Height="16"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="0"/>
                                <TextBox x:Name="SearchBox"
                                         BorderThickness="0" Background="Transparent" Foreground="Black"
                                         VerticalAlignment="Center" Grid.Column="1"
                                         Text="Buscar..."
                                         GotFocus="SearchBox_GotFocus"
                                         LostFocus="SearchBox_LostFocus"
                                         TextChanged="SearchBox_TextChanged"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Estado vacío -->
                    <TextBlock x:Name="EmptyState"
                               Text="Aún no tienes favoritos ⭐"
                               HorizontalAlignment="Center" Opacity="0.7" Margin="0,10,0,0"/>

                    <!-- Lista de favoritos (desde repositorio) -->
                    <ItemsControl x:Name="FavList" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Margin="5" Background="#FFFFFF" Width="120" Height="160" Padding="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- imagen (ícono según Tipo) -->
                                        <Border CornerRadius="8" Background="#EEE">
                                            <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
                                        </Border>

                                        <!-- texto -->
                                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Type}" Opacity="0.7" FontSize="11"/>
                                        </StackPanel>

                                        <!-- ⭐ quitar -->
                                        <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="Transparent" BorderBrush="Transparent"
                                                Click="Star_Remove_Click" Tag="{Binding}">
                                            <Image Source="/Images/Iconos/star_filled.png"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
