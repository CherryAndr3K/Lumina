<Window x:Class="Lumina.Views.Peliculas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMINA - Películas" Height="576" Width="829"
        Background="#EDEDE9"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <!-- Grid principal que contendrá la barra superior y el resto del contenido -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!-- Barra superior -->
            <RowDefinition Height="*"/>
            <!-- Contenido principal -->
        </Grid.RowDefinitions>

        <!-- Barra superior personalizada -->
        <Grid Height="40" Background="#D6CCC2" Grid.Row="0" MouseDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Título de la ventana -->
            <TextBlock Text="LUMINA" VerticalAlignment="Top" Margin="10,4,0,0"
                       FontWeight="Bold" FontSize="16"/>

            <!-- Botones de ventana -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Top" Margin="0,6,10,0">
                <!-- Botón Minimizar -->
                <Button Width="15" Height="15" Margin="2" Click="Minimize_Click" Background="Transparent" BorderThickness="0">
                    <Image Source="C:\Users\andre\Desktop\Lumina\Lumina\Lumina\Images\Iconos\minimizar.png" Stretch="Uniform"/>
                </Button>

                <!-- Botón Maximizar / Restaurar -->
                <Button x:Name="MaximizeButton" Width="15" Height="15" Margin="2" Click="Maximize_Click" Background="Transparent" BorderThickness="0">
                    <Image x:Name="MaximizeIcon" Source="/Images/Iconos/maximizar.png" Stretch="Uniform"/>
                </Button>

                <!-- Botón Cerrar -->
                <Button Width="15" Height="15" Margin="2" Click="Close_Click" Background="Transparent" BorderThickness="0">
                    <Image Source="C:\Users\andre\Desktop\Lumina\Lumina\Lumina\Images\Iconos\cerrar.png" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Contenido principal con barra lateral y ScrollViewer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="143*"/>
                <ColumnDefinition Width="21*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="18*"/>
                <ColumnDefinition Width="557*"/>
            </Grid.ColumnDefinitions>

            <!-- Barra lateral izquierda -->
            <Grid Grid.Column="0" Background="#E3D5CA" Margin="0,0,4,0" Grid.ColumnSpan="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="">
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Home_Click">
                        <Image Source="/Images/Iconos/Home.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Libros_Click">
                        <Image Source="C:\Users\andre\Desktop\Lumina\Lumina\Lumina\Images\Iconos\Libros.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Musica_Click">
                        <Image Source="C:\Users\andre\Desktop\Lumina\Lumina\Lumina\Images\Iconos\Musica.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Peliculas_Click">
                        <Image Source="C:\Users\andre\Desktop\Lumina\Lumina\Lumina\Images\Iconos\Pelicula.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Favoritos_Click">
                        <Image Source="C:\Users\andre\Desktop\Lumina\Lumina\Lumina\Images\Iconos\Favoritos.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" BorderBrush="Transparent" Background="Transparent" Click="Login_Click">
                        <Image Source="C:\Users\andre\Desktop\Lumina\Lumina\Lumina\Images\Iconos\usuario.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Contenido principal con ScrollViewer -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="6" Margin="46,0,0,0" Grid.Column="1">
                <StackPanel Margin="20">
                    <!-- Encabezado -->
                    <DockPanel Margin="0,0,0,10" LastChildFill="True">

                        <!-- Botón Editar (derecha) -->
                        <Button DockPanel.Dock="Right"
                                Click="PeliculasR"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Margin="5,0,0,0">
                            <Image Source="/Images/Iconos/editar.png"
                                   Width="24"
                                   Height="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Button>

                        <!-- Buscador -->
                        <Border DockPanel.Dock="Right"
                                CornerRadius="15"
                                Background="#D6CCC2"
                                Width="232"
                                Height="30"
                                Margin="10,0,5,0"
                                VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="/Images/Iconos/lupa.png"
                                       Width="16" Height="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Grid.Column="0"/>

                                <TextBox x:Name="SearchTextBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="Black"
                                         VerticalAlignment="Center"
                                         Grid.Column="1"
                                         Text="Buscar..."
                                         GotFocus="SearchBox_GotFocus"
                                         LostFocus="SearchBox_LostFocus"/>
                            </Grid>
                        </Border>

                        <!-- Título (izquierda) -->
                        <TextBlock Text="Películas"
                                   FontFamily="Fonts/#Roboto"
                                   FontSize="25"
                                   FontWeight="Regular"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Foreground="Black"
                                   Margin="0,2,0,0"/>
                    </DockPanel>

                    <!-- Sección Películas -->
                    <TextBlock FontSize="19"
                               FontFamily="Fonts/#Roboto"
                               FontWeight="Thin"
                               Margin="0,20,0,10"
                               Text="Todas las películas"/>

                    <ItemsControl ItemsSource="{Binding PeliculasList}">
                        <ItemsControl.Resources>
                            <Style x:Key="PosterImg" TargetType="Image">
                                <Setter Property="Width" Value="110"/>
                                <Setter Property="Height" Value="140"/>
                                <Setter Property="Stretch" Value="Fill"/>
                                <Setter Property="Clip">
                                    <Setter.Value>
                                        <RectangleGeometry Rect="0,0,110,140" RadiusX="10" RadiusY="10"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.Resources>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="110" Height="140" Margin="5">
                                    <!-- Portada desde BD -->
                                    <Image Source="{Binding Imagen}"
                                           Style="{StaticResource PosterImg}"/>

                                    <!-- Botón que abre el link de la peli -->
                                    <Button Width="110"
                                            Height="140"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Click="PeliLink_Click"
                                            Tag="{Binding Link}"/>

                                    <!-- Estrellita de favorito -->
                                    <Button Width="22" Height="22"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="6"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Click="Star_Toggle_Click"
                                            Loaded="Star_Loaded">
                                        <Button.Tag>
                                            <!-- tipo|Titulo|Imagen -->
                                            <MultiBinding StringFormat="Movie|{0}|{1}">
                                                <Binding Path="Titulo"/>
                                                <Binding Path="Imagen"/>
                                            </MultiBinding>
                                        </Button.Tag>
                                        <Image Width="18" Height="18"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
