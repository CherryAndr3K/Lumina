<Window x:Class="Lumina.Views.Peliculas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMINA - Películas" Height="576" Width="829"
        Background="#EDEDE9"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <!-- Grid principal que contendrá la barra superior y el resto del contenido -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!-- Barra superior -->
            <RowDefinition Height="*"/>
            <!-- Contenido principal -->
        </Grid.RowDefinitions>

        <!-- Barra superior personalizada -->
        <Grid Height="40" Background="#D6CCC2" Grid.Row="0" MouseDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Título de la ventana -->
            <TextBlock Text="LUMINA" VerticalAlignment="Top" Margin="10,4,0,0"
                       FontWeight="Bold" FontSize="16"/>

            <!-- Botones de ventana -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Top" Margin="0,6,10,0">
                <!-- Botón Minimizar -->
                <Button Width="15" Height="15" Margin="2" Click="Minimize_Click" Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/minimizar.png" Stretch="Uniform"/>
                </Button>

                <!-- Botón Maximizar / Restaurar -->
                <Button x:Name="MaximizeButton" Width="15" Height="15" Margin="2" Click="Maximize_Click" Background="Transparent" BorderThickness="0">
                    <Image x:Name="MaximizeIcon" Source="/Images/Iconos/maximizar.png" Stretch="Uniform"/>
                </Button>

                <!-- Botón Cerrar -->
                <Button Width="15" Height="15" Margin="2" Click="Close_Click" Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/cerrar.png" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Contenido principal con barra lateral y ScrollViewer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="143*"/>
                <ColumnDefinition Width="21*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="18*"/>
                <ColumnDefinition Width="557*"/>
            </Grid.ColumnDefinitions>

            <!-- Barra lateral izquierda -->
            <Grid Grid.Column="0" Background="#E3D5CA" Margin="0,0,4,0" Grid.ColumnSpan="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="">
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Home_Click">
                        <Image Source="/Images/Iconos/Home.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Libros_Click">
                        <Image Source="/Images/Iconos/Libros.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Musica_Click">
                        <Image Source="/Images/Iconos/Musica.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Peliculas_Click">
                        <Image Source="/Images/Iconos/Pelicula.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Favoritos_Click">
                        <Image Source="/Images/Iconos/Favoritos.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" BorderBrush="Transparent" Background="Transparent" Click="Login_Click">
                        <Image Source="C:\Users\andre\Desktop\Lumina\Lumina\Lumina\Images\Iconos\usuario.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Contenido principal con ScrollViewer -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="6" Margin="46,0,0,0" Grid.Column="1">
                <StackPanel Margin="20">
                    <!-- Encabezado -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Peliculas" FontFamily="Fonts/#Roboto" FontSize="25" FontWeight="Regular" VerticalAlignment="Center" Grid.Column="0" Margin="0,2,0,0"/>
                        <Border CornerRadius="15" Background="#D6CCC2" Width="232" Grid.Column="1" Margin="0,0,5,0" Cursor="Help">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="/Images/Iconos/lupa.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="0"/>
                                <TextBox x:Name="SearchTextBox" BorderThickness="0" Background="Transparent" Foreground="Black" VerticalAlignment="Center" Margin="0,0,0,0" Grid.Column="1" Text="Buscar..." GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Sección Películas -->
                    <TextBlock FontSize="19" FontFamily="Fonts/#Roboto" FontWeight="Thin" Margin="0,20,0,10" Text="Todas las peliculas"/>

                    <ItemsControl>
                        <ItemsControl.Resources>
                            <Style x:Key="PosterImg" TargetType="Image">
                                <Setter Property="Width" Value="110"/>
                                <Setter Property="Height" Value="140"/>
                                <Setter Property="Stretch" Value="Fill"/>
                                <Setter Property="Clip">
                                    <Setter.Value>
                                        <RectangleGeometry Rect="0,0,110,140" RadiusX="10" RadiusY="10"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.Resources>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- Huevos -->
                        <Grid Width="110" Height="140" Margin="5">
                            <Image Source="/Images/Peliculas/Huevos.jpg"
           Style="{StaticResource PosterImg}"
           MouseLeftButtonUp="Poster_Click"
           Tag="https://www.youtube.com/watch?v=5bgjbk1wInA"/>
                            <Button Width="22" Height="22"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
            Background="Transparent" BorderBrush="Transparent"
            Click="Star_Toggle_Click" Loaded="Star_Loaded"
            Tag="Movie|Huevos|/Images/Peliculas/Huevos.jpg">
                                <Image x:Name="StarIcon" Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- Pollo -->
                        <Grid Width="110" Height="140" Margin="5">
                            <Image Source="/Images/Peliculas/Pollo.jpg"
           Style="{StaticResource PosterImg}"
           MouseLeftButtonUp="Poster_Click"
           Tag="https://www.youtube.com/watch?v=FeuHkSOYSMY"/>
                            <Button Width="22" Height="22"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
            Background="Transparent" BorderBrush="Transparent"
            Click="Star_Toggle_Click" Loaded="Star_Loaded"
            Tag="Movie|Pollo|/Images/Peliculas/Pollo.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- Gallo -->
                        <Grid Width="110" Height="140" Margin="5">
                            <Image Source="/Images/Peliculas/Gallo.jpg"
           Style="{StaticResource PosterImg}"
           MouseLeftButtonUp="Poster_Click"
           Tag="https://www.youtube.com/watch?v=KL_TRDegmpo"/>
                            <Button Width="22" Height="22"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
            Background="Transparent" BorderBrush="Transparent"
            Click="Star_Toggle_Click" Loaded="Star_Loaded"
            Tag="Movie|Gallo|/Images/Peliculas/Gallo.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- Cónclave -->
                        <Grid Width="110" Height="140" Margin="5">
                            <Image Source="/Images/Peliculas/Conclave.jpg"
           Style="{StaticResource PosterImg}"
           MouseLeftButtonUp="Poster_Click"
           Tag="https://pelisplus.la/peliculas/conclave-2024"/>
                            <Button Width="22" Height="22"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
            Background="Transparent" BorderBrush="Transparent"
            Click="Star_Toggle_Click" Loaded="Star_Loaded"
            Tag="Movie|Conclave|/Images/Peliculas/Conclave.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- Mamma Mia -->
                        <Grid Width="110" Height="140" Margin="5">
                            <Image Source="/Images/Peliculas/Mammamia.jpg"
           Style="{StaticResource PosterImg}"
           MouseLeftButtonUp="Poster_Click"
           Tag="https://pelisplus.la/peliculas/mamma-mia-2008"/>
                            <Button Width="22" Height="22"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
            Background="Transparent" BorderBrush="Transparent"
            Click="Star_Toggle_Click" Loaded="Star_Loaded"
            Tag="Movie|Mammamia|/Images/Peliculas/Mammamia.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- Castle -->
                        <Grid Width="110" Height="140" Margin="5">
                            <Image Source="/Images/Peliculas/Castle.jpg"
           Style="{StaticResource PosterImg}"
           MouseLeftButtonUp="Poster_Click"
           Tag="https://pelisplus.la/peliculas/el-increible-castillo-vagabundo-2004"/>
                            <Button Width="22" Height="22"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
            Background="Transparent" BorderBrush="Transparent"
            Click="Star_Toggle_Click" Loaded="Star_Loaded"
            Tag="Movie|Castle|/Images/Peliculas/Castle.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- Your Name -->
                        <Grid Width="110" Height="140" Margin="5">
                            <Image Source="/Images/Peliculas/YourName.jpg"
           Style="{StaticResource PosterImg}"
           MouseLeftButtonUp="Poster_Click"
           Tag="https://pelisplus.la/peliculas/your-name-2016"/>
                            <Button Width="22" Height="22"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
            Background="Transparent" BorderBrush="Transparent"
            Click="Star_Toggle_Click" Loaded="Star_Loaded"
            Tag="Movie|YourName|/Images/Peliculas/YourName.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- Captain -->
                        <Grid Width="110" Height="140" Margin="5">
                            <Image Source="/Images/Peliculas/Captain.jpg"
           Style="{StaticResource PosterImg}"
           MouseLeftButtonUp="Poster_Click"
           Tag="https://pelisplus.la/peliculas/capitan-america-y-el-soldado-del-invierno-2014"/>
                            <Button Width="22" Height="22"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
            Background="Transparent" BorderBrush="Transparent"
            Click="Star_Toggle_Click" Loaded="Star_Loaded"
            Tag="Movie|Captain|/Images/Peliculas/Captain.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>