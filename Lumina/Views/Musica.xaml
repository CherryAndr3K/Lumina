<Window x:Class="Lumina.Views.Musica"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMINA - Música" Height="576" Width="829"
        Background="#EDEDE9"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <!-- Grid principal que contendrá la barra superior y el resto del contenido -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!-- Barra superior -->
            <RowDefinition Height="*"/>
            <!-- Contenido principal -->
        </Grid.RowDefinitions>

        <!-- Barra superior personalizada -->
        <Grid Height="40" Background="#D6CCC2" Grid.Row="0" MouseDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Título de la ventana -->
            <TextBlock Text="LUMINA" VerticalAlignment="Top" Margin="10,4,0,0"
                       FontWeight="Bold" FontSize="16"/>

            <!-- Botones de ventana -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Top" Margin="0,6,10,0">
                <!-- Botón Minimizar -->
                <Button Width="15" Height="15" Margin="2" Click="Minimize_Click" Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/minimizar.png" Stretch="Uniform"/>
                </Button>

                <!-- Botón Maximizar / Restaurar -->
                <Button Width="15" Height="15" Margin="2" Click="Maximize_Click" Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/maximizar.png" Stretch="Uniform"/>
                </Button>

                <!-- Botón Cerrar -->
                <Button Width="15" Height="15" Margin="2" Click="Close_Click" Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/cerrar.png" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Contenido principal con barra lateral y ScrollViewer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="143*"/>
                <ColumnDefinition Width="21*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="18*"/>
                <ColumnDefinition Width="557*"/>
            </Grid.ColumnDefinitions>

            <!-- Barra lateral izquierda -->
            <Grid Grid.Column="0" Background="#E3D5CA" Margin="0,0,4,0" Grid.ColumnSpan="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="">
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Home_Click">
                        <Image Source="/Images/Iconos/Home.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Libros_Click">
                        <Image Source="/Images/Iconos/Libros.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent">
                        <Image Source="/Images/Iconos/Musica.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Peliculas_Click">
                        <Image Source="/Images/Iconos/Pelicula.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent" Click="Favoritos_Click">
                        <Image Source="/Images/Iconos/Favoritos.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" BorderBrush="Transparent" Background="Transparent" Click="Login_Click">
                        <Image Source="C:\Users\andre\Desktop\Lumina\Lumina\Lumina\Images\Iconos\usuario.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Contenido principal con ScrollViewer -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="6" Margin="46,0,0,0" Grid.Column="1">
                <StackPanel Margin="20">
                    <!-- Encabezado -->
                    <!-- Encabezado -->
                    <DockPanel Margin="0,0,0,10" LastChildFill="True">

                        <!-- Botón Editar (derecha) -->
                        <Button DockPanel.Dock="Right"
            Click="MusicaR"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Padding="0"
            VerticalAlignment="Center"
            Margin="5,0,0,0">
                            <Image Source="/Images/Iconos/editar.png"
               Width="24"
               Height="24"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                        </Button>

                        <!-- Buscador (a la derecha del texto) -->
                        <Border DockPanel.Dock="Right"
            CornerRadius="15"
            Background="#D6CCC2"
            Width="232"
            Height="30"
            Margin="10,0,5,0"
            VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="/Images/Iconos/lupa.png"
                   Width="16" Height="16"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Grid.Column="0"/>

                                <TextBox x:Name="SearchTextBox"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="Black"
                     VerticalAlignment="Center"
                     Grid.Column="1"
                     Text="Buscar..."
                     GotFocus="SearchBox_GotFocus"
                     LostFocus="SearchBox_LostFocus"/>
                            </Grid>
                        </Border>

                        <!-- Título (izquierda) -->
                        <TextBlock Text="Musica"
               FontFamily="Fonts/#Roboto"
               FontSize="25"
               FontWeight="Regular"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"
               Foreground="Black"
               Margin="0,2,0,0"/>
                    </DockPanel>


                    <!-- Sección Música -->
                    <TextBlock FontSize="19" FontFamily="Fonts/#Roboto" FontWeight="Thin" Margin="0,20,0,10"><Run Text="Tod"/><Run Text="os los albumes"/></TextBlock>
                    <ItemsControl>
                        <ItemsControl.Resources>
                            <!-- Portadas cuadradas 120x120 con esquinas redondeadas -->
                            <Style x:Key="MusicImg" TargetType="Image">
                                <Setter Property="Width" Value="120"/>
                                <Setter Property="Height" Value="120"/>
                                <Setter Property="Stretch" Value="Fill"/>
                                <Setter Property="Clip">
                                    <Setter.Value>
                                        <RectangleGeometry Rect="0,0,120,120" RadiusX="10" RadiusY="10"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.Resources>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- HMHAS -->
                        <Grid Width="120" Height="120" Margin="5">
                            <Image Source="/Images/Musica/HMHAS.jpg" Style="{StaticResource MusicImg}"/>
                            <Button Width="120" Height="120"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="MusicLink_Click"
                                    Tag="https://open.spotify.com/intl-es/album/1aqg30bNvLSWgShZgX4oop?si=nCNQ8mMVSaSnn8xABvB6bw">
                            </Button>
                            <Button Width="22" Height="22"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="Star_Toggle_Click" Loaded="Star_Loaded"
                                    Tag="Music|HMHAS|/Images/Musica/HMHAS.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- MBF -->
                        <Grid Width="120" Height="120" Margin="5">
                            <Image Source="/Images/Musica/MBF.jpg" Style="{StaticResource MusicImg}"/>
                            <Button Width="120" Height="120"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="MusicLink_Click"
                                    Tag="https://open.spotify.com/intl-es/album/7aJuG4TFXa2hmE4z1yxc3n?si=So9DIOeqQACaavxKm_LBKg">
                            </Button>
                            <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="Star_Toggle_Click" Loaded="Star_Loaded"
                                    Tag="Music|MBF|/Images/Musica/MBF.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- 1989 -->
                        <Grid Width="120" Height="120" Margin="5">
                            <Image Source="/Images/Musica/1989.jpg" Style="{StaticResource MusicImg}"/>
                            <Button Width="120" Height="120"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="MusicLink_Click"
                                    Tag="https://open.spotify.com/intl-es/album/1yGbNOtRIgdIiGHOEBaZWf?si=kp0If4-dTC2lros1e11jzQ">
                            </Button>
                            <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="Star_Toggle_Click" Loaded="Star_Loaded"
                                    Tag="Music|1989|/Images/Musica/1989.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- TBP -->
                        <Grid Width="120" Height="120" Margin="5">
                            <Image Source="/Images/Musica/TBP.jpg" Style="{StaticResource MusicImg}"/>
                            <Button Width="120" Height="120"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="MusicLink_Click"
                                    Tag="https://open.spotify.com/intl-es/album/0FZK97MXMm5mUQ8mtudjuK?si=oiRRiQRyQUCNsz141VxsFg">
                            </Button>
                            <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="Star_Toggle_Click" Loaded="Star_Loaded"
                                    Tag="Music|TBP|/Images/Musica/TBP.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- FancyT -->
                        <Grid Width="120" Height="120" Margin="5">
                            <Image Source="/Images/Musica/FancyT.jpg" Style="{StaticResource MusicImg}"/>
                            <Button Width="120" Height="120"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="MusicLink_Click"
                                    Tag="https://open.spotify.com/intl-es/album/3o81FH5FTYVtoBQOZr3T7y?si=1mKp3dA1TLektVlDAkgQVw">
                            </Button>
                            <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="Star_Toggle_Click" Loaded="Star_Loaded"
                                    Tag="Music|FancyT|/Images/Musica/FancyT.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- Spanish -->
                        <Grid Width="120" Height="120" Margin="5">
                            <Image Source="/Images/Musica/Spanish.jpg" Style="{StaticResource MusicImg}"/>
                            <Button Width="120" Height="120"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="MusicLink_Click"
                                    Tag="https://open.spotify.com/intl-es/album/1inJBfnZWe33KcXl6TNaXV?si=EgsblTAQQqW2jbv0ypH0dA">
                            </Button>
                            <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="Star_Toggle_Click" Loaded="Star_Loaded"
                                    Tag="Music|Spanish|/Images/Musica/Spanish.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- BNE -->
                        <Grid Width="120" Height="120" Margin="5">
                            <Image Source="/Images/Musica/BNE.jpg" Style="{StaticResource MusicImg}"/>
                            <Button Width="120" Height="120"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="MusicLink_Click"
                                    Tag="https://open.spotify.com/intl-es/album/27UqZoE1kV6sIV6uQcI28A?si=HunX322RSTC7dmeZgRtEAQ">
                            </Button>
                            <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="Star_Toggle_Click" Loaded="Star_Loaded"
                                    Tag="Music|BNE|/Images/Musica/BNE.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- Huntrix -->
                        <Grid Width="120" Height="120" Margin="5">
                            <Image Source="/Images/Musica/Huntrix.jpg" Style="{StaticResource MusicImg}"/>
                            <Button Width="120" Height="120"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="MusicLink_Click"
                                    Tag="https://open.spotify.com/intl-es/album/14JkAa6IiFaOh5s0nMyMU9?si=WAzy7qyUTqqqk63kAePE7g">
                            </Button>
                            <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="Star_Toggle_Click" Loaded="Star_Loaded"
                                    Tag="Music|Huntrix|/Images/Musica/Huntrix.jpg">
                                <Image Source="/Images/Iconos/star_outline.png" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>