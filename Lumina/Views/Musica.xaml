<Page x:Class="Lumina.Musica"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inicio" Height="576" Width="829"
        Background="#EDEDE9">

    <!-- Grid principal que contendrá la barra superior y el resto del contenido -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!-- Barra superior -->
            <RowDefinition Height="*"/>
            <!-- Contenido principal -->
        </Grid.RowDefinitions>

        <!-- Barra superior personalizada -->
        <Grid Height="40" Background="#D6CCC2" Grid.Row="0" MouseDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Título de la ventana -->
            <TextBlock Text="LUMINA" VerticalAlignment="Top" Margin="10,4,0,0"
                       FontWeight="Bold" FontSize="16"/>

            <!-- Botones de ventana -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Top" Margin="0,6,10,0">
                <!-- Botón Minimizar -->
                <Button Width="15" Height="15" Margin="2" Click="Minimize_Click" Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/minimizar.png" Stretch="Uniform"/>
                </Button>

                <!-- Botón Maximizar / Restaurar -->
                <Button Width="15" Height="15" Margin="2" Click="MaximizeRestore_Click" Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/maximizar.png" Stretch="Uniform"/>
                </Button>

                <!-- Botón Cerrar -->
                <Button Width="15" Height="15" Margin="2" Click="Close_Click" Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/cerrar.png" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Contenido principal con barra lateral y ScrollViewer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="143*"/>
                <ColumnDefinition Width="21*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="18*"/>
                <ColumnDefinition Width="557*"/>
            </Grid.ColumnDefinitions>

            <!-- Barra lateral izquierda -->
            <Grid Grid.Column="0" Background="#E3D5CA" Margin="0,0,4,0" Grid.ColumnSpan="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="">
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent">
                        <Image Source="/Images/Iconos/Home.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent">
                        <Image Source="/Images/Iconos/Libros.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent">
                        <Image Source="/Images/Iconos/Musica.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent">
                        <Image Source="/Images/Iconos/Pelicula.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="40" Height="40" Margin="5" BorderBrush="Transparent" Background="Transparent">
                        <Image Source="/Images/Iconos/Favoritos.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Contenido principal con ScrollViewer -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="6" Margin="46,0,0,0" Grid.Column="1">
                <StackPanel Margin="20">
                    <!-- Encabezado -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HomePage" FontFamily="Fonts/#Roboto" FontSize="25" FontWeight="Regular" VerticalAlignment="Center" Grid.Column="0" Margin="0,2,0,0"/>
                        <Border CornerRadius="15" Background="#D6CCC2" Width="232" Grid.Column="1" Margin="0,0,5,0" Cursor="Help">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="/Images/Iconos/lupa.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="0"/>
                                <TextBox BorderThickness="0" Background="Transparent" Foreground="Black" VerticalAlignment="Center" Margin="0,0,0,0" Grid.Column="1" Text="Buscar..." GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Sección Música -->
                    <TextBlock Text="Destacadas" FontSize="19" FontFamily="Fonts/#Roboto" FontWeight="Thin" Margin="0,20,0,10"/>
                    <ItemsControl>
                        <ItemsControl.Resources>
                            <Style TargetType="Image">
                                <Setter Property="Width" Value="80"/>
                                <Setter Property="Height" Value="80"/>
                                <Setter Property="Stretch" Value="Fill"/>
                                <Setter Property="Margin" Value="5"/>
                                <Setter Property="Clip">
                                    <Setter.Value>
                                        <RectangleGeometry Rect="0,0,80,80" RadiusX="10" RadiusY="10"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <Image Source="/Images/Musica/HMHAS.jpg"/>
                        <Image Source="/Images/Musica/MBF.jpg"/>
                        <Image Source="/Images/Musica/1989.jpg"/>
                        <Image Source="/Images/Musica/TBP.jpg"/>
                        <Image Source="/Images/Musica/FancyT.jpg"/>
                        <Image Source="/Images/Musica/Spanish.jpg"/>
                        <Image Source="/Images/Musica/BNE.jpg"/>
                        <Button Width="80" Height="80" Margin="5" BorderBrush="Transparent" Background="Transparent">
                            <Border CornerRadius="10" ClipToBounds="True">
                                <Grid>
                                    <Image Source="/Images/Musica/Huntrix.jpg" Stretch="Fill" Margin="-2,-2,-2,-3">
                                        <Image.Effect>
                                            <BlurEffect/>
                                        </Image.Effect>
                                    </Image>
                                    <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Black" FontWeight="Light" Height="63"/>
                                </Grid>
                            </Border>
                        </Button>
                    </ItemsControl>

                    <!-- Sección Música -->
                    <TextBlock Text="Recientes" FontSize="19" FontFamily="Fonts/#Roboto" FontWeight="Thin" Margin="0,20,0,10"/>
                    <ItemsControl>
                        <ItemsControl.Resources>
                            <Style TargetType="Image">
                                <Setter Property="Width" Value="80"/>
                                <Setter Property="Height" Value="80"/>
                                <Setter Property="Stretch" Value="Fill"/>
                                <Setter Property="Margin" Value="5"/>
                                <Setter Property="Clip">
                                    <Setter.Value>
                                        <RectangleGeometry Rect="0,0,80,80" RadiusX="10" RadiusY="10"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <Image Source="/Images/Musica/HMHAS.jpg"/>
                        <Image Source="/Images/Musica/MBF.jpg"/>
                        <Image Source="/Images/Musica/1989.jpg"/>
                        <Image Source="/Images/Musica/TBP.jpg"/>
                        <Image Source="/Images/Musica/FancyT.jpg"/>
                        <Image Source="/Images/Musica/Spanish.jpg"/>
                        <Image Source="/Images/Musica/BNE.jpg"/>
                        <Button Width="80" Height="80" Margin="5" BorderBrush="Transparent" Background="Transparent">
                            <Border CornerRadius="10" ClipToBounds="True">
                                <Grid>
                                    <Image Source="/Images/Musica/Huntrix.jpg" Stretch="Fill" Margin="-2,-2,-2,-3">
                                        <Image.Effect>
                                            <BlurEffect/>
                                        </Image.Effect>
                                    </Image>
                                    <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Black" FontWeight="Light" Height="63"/>
                                </Grid>
                            </Border>
                        </Button>
                    </ItemsControl>

                    <!-- Sección Música -->
                    <TextBlock Text="Favoritos" FontSize="19" FontFamily="Fonts/#Roboto" FontWeight="Thin" Margin="0,20,0,10"/>
                    <ItemsControl>
                        <ItemsControl.Resources>
                            <Style TargetType="Image">
                                <Setter Property="Width" Value="80"/>
                                <Setter Property="Height" Value="80"/>
                                <Setter Property="Stretch" Value="Fill"/>
                                <Setter Property="Margin" Value="5"/>
                                <Setter Property="Clip">
                                    <Setter.Value>
                                        <RectangleGeometry Rect="0,0,80,80" RadiusX="10" RadiusY="10"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <Image Source="/Images/Musica/HMHAS.jpg"/>
                        <Image Source="/Images/Musica/MBF.jpg"/>
                        <Image Source="/Images/Musica/1989.jpg"/>
                        <Image Source="/Images/Musica/TBP.jpg"/>
                        <Image Source="/Images/Musica/FancyT.jpg"/>
                        <Image Source="/Images/Musica/Spanish.jpg"/>
                        <Image Source="/Images/Musica/BNE.jpg"/>
                        <Button Width="80" Height="80" Margin="5" BorderBrush="Transparent" Background="Transparent">
                            <Border CornerRadius="10" ClipToBounds="True">
                                <Grid>
                                    <Image Source="/Images/Musica/Huntrix.jpg" Stretch="Fill" Margin="-2,-2,-2,-3">
                                        <Image.Effect>
                                            <BlurEffect/>
                                        </Image.Effect>
                                    </Image>
                                    <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Black" FontWeight="Light" Height="63"/>
                                </Grid>
                            </Border>
                        </Button>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

