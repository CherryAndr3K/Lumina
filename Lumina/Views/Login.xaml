<Window x:Class="Lumina.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lumina"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800">
    <Window.Resources>
        <!-- Estilo para botones redondeados -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="20"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedInput" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="20"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                              VerticalAlignment="Center"
                              Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Contenedor principal -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- Barra superior -->
            <RowDefinition Height="*"/>
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- Barra superior personalizada -->
        <Grid Background="#D6CCC2" Grid.Row="0" MouseDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Título de la ventana -->
            <TextBlock Text="LUMINA" VerticalAlignment="Center" Margin="10,0,0,0"
                   FontWeight="Bold" FontSize="16"/>

            <!-- Botones de ventana -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <!-- Minimizar -->
                <Button Width="15" Height="15" Margin="2" Click="Minimize_Click"
                    Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/minimizar.png" Stretch="Uniform"/>
                </Button>
                <!-- Maximizar/Restaurar -->
                <Button Width="15" Height="15" Margin="2" Click="MaximizeRestore_Click"
                    Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/maximizar.png" Stretch="Uniform"/>
                </Button>
                <!-- Cerrar -->
                <Button Width="15" Height="15" Margin="2" Click="Close_Click"
                    Background="Transparent" BorderThickness="0">
                    <Image Source="/Images/Iconos/cerrar.png" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Contenido principal -->
        <Grid Grid.Row="1">
            <!-- Tres columnas: centramos el contenido en la del medio -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="280">

                <!-- Título principal -->
                <TextBlock Text="Lumina"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

                <!-- Subtítulo -->
                <TextBlock Text="Perfil"
                       FontSize="20"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

                <!-- Avatar con flechas -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <!-- Flecha izquierda -->
                    <Button Content="⟨"
                        FontSize="20"
                        Width="40" Height="40"
                        Background="Transparent"
                        BorderThickness="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"/>

                    <!-- Imagen avatar redonda -->
                    <Border Grid.Column="1"
                        Width="180" Height="180"
                        Background="Transparent"
                        CornerRadius="90">
                        <Image Source="/Images/Avatares/Kat_Lumina1.png"
                           Width="180" Height="180"
                           Stretch="Uniform">
                            <Image.Clip>
                                <EllipseGeometry Center="90,90" RadiusX="90" RadiusY="90"/>
                            </Image.Clip>
                        </Image>
                    </Border>

                    <!-- Flecha derecha -->
                    <Button Content="⟩"
                        FontSize="20"
                        Width="40" Height="40"
                        Background="Transparent"
                        BorderThickness="0"
                        Grid.Column="2"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Botones inferiores -->
                <!-- Botones inferiores / campos -->
                <TextBox x:Name="txtCorreo"
            Style="{StaticResource RoundedInput}"
            Text="Correo"
            Tag="Correo"
            Foreground="Gray"
            GotFocus="Placeholder_GotFocus"
            LostFocus="Placeholder_LostFocus"
            Margin="0,15,0,0"/>

                <TextBox x:Name="txtNombre"
            Style="{StaticResource RoundedInput}"
            Text="Nombre"
            Tag="Nombre"
            Foreground="Gray"
            GotFocus="Placeholder_GotFocus"
            LostFocus="Placeholder_LostFocus"
            Margin="0,15,0,0"/>

                <Button Content="Guardar"
            Style="{StaticResource RoundedButton}"
            Margin="0,15,0,0"
            Background="#d9dcd6"
            Click="Guardar_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
